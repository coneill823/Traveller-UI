# Copy to .env and adjust. Every setting is optional.

# Port the server listens on.
PORT=8787

# Where the campaign database and uploaded images are kept.
DATA_DIR=data

# Set a GM passphrase here to skip the first-run setup screen (useful for hosted installs).
# GM_PASSWORD=

# ── Chronicler wiki ──────────────────────────────────────────────────────────
# Option 1: the vault folder on this computer (the folder Chronicler has open).
# WIKI_DIR=C:\Users\you\Documents\Traveller-Campaign

# Option 2: the vault's GitHub repository. The token needs "Contents: read and write"
# on that repository only (GitHub → Settings → Developer settings → Fine-grained tokens).
# WIKI_REPO=your-name/Traveller-Campaign
# WIKI_BRANCH=main
# WIKI_TOKEN=github_pat_...
# WIKI_POLL_SECONDS=60

# Folder inside the vault where the app creates pages for systems.
# WIKI_ATLAS_FOLDER=Atlas

# ── Rules packs ──────────────────────────────────────────────────────────────
# Folder of rules packs (one sub-folder per pack). Packs kept in the wiki vault under
# .traveller-ui/rulepacks are loaded as well, so with WIKI_DIR or WIKI_REPO set this
# can be left alone.
# RULEPACK_DIR=rulepacks
